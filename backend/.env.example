# ==============================================================================
# GoAgain Backend Environment Configuration Template
# ==============================================================================
# Rename or copy this file to .env in the backend folder and fill in your values.

# ----------------- Application & Security -----------------
PROJECT_NAME="GoAgain Loyalty SaaS"
API_V1_STR="/api/v1"
SECRET_KEY="replace-with-a-secure-random-secret-key"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ----------------- Database -----------------
# SQLite default:
DATABASE_URL="sqlite:///./loyalty_saas.db"
# PostgreSQL example:
# DATABASE_URL="postgresql://user:password@localhost:5432/loyalty_saas"

# ----------------- WhatsApp & Meta Cloud API -----------------
# Set to 'true' to use live Meta Cloud API, 'false' for sandbox mock mode
USE_LIVE_WHATSAPP=false

# Meta Graph API version
META_GRAPH_API_VERSION="v22.0"

# Meta App credentials (from developers.facebook.com)
META_APP_ID="your_meta_app_id"
META_APP_SECRET="your_meta_app_secret"

# Meta Webhook verification token
META_WEBHOOK_VERIFY_TOKEN="your_webhook_verify_token"

# Embedded Signup Configuration ID (optional, from Meta WhatsApp manager)
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=""

# ----------------- Default Message Pricing (in INR) -----------------
DEFAULT_MESSAGE_PRICE_MARKETING=0.78
DEFAULT_MESSAGE_PRICE_UTILITY=0.35
DEFAULT_MESSAGE_PRICE_AUTHENTICATION=0.30
DEFAULT_MESSAGE_PRICE_SERVICE=0.25

# ----------------- CORS & Frontend URL -----------------
FRONTEND_URL="http://localhost:5173"
